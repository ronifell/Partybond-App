{
  "expo": {
    "name": "Partybond",
    "slug": "partybond",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "partybond",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A12"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.partybond.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "We need access to your photos so you can pick a profile picture.",
        "NSCameraUsageDescription": "We need access to your camera to take a profile picture."
      }
    },
    "android": {
      "package": "com.partybond.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A12"
      },
      "permissions": ["READ_EXTERNAL_STORAGE", "CAMERA"]
    },
    "plugins": [
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Partybond to access your photos.",
          "cameraPermission": "Allow Partybond to access your camera."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#7B3FF2"
        }
      ],
      "expo-font"
    ],
    "extra": {
      "apiUrl": "http://18.231.112.145:4000"
    }
  }
}
