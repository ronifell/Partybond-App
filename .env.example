# API (no /api/v1 suffix)
# EXPO_PUBLIC_API_URL=http://localhost:4000

# Google Sign-In — create at https://console.cloud.google.com/apis/credentials
# Web client ID is required. Android/iOS IDs needed for release builds.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com

# # Expo Go only (npx expo start + Expo Go): must match an authorized redirect URI on your *Web* OAuth client.
# # Example: https://auth.expo.io/@yourusername/your-app-slug
# EXPO_PUBLIC_EXPO_AUTH_PROXY_REDIRECT_URI=https://auth.expo.io/@hayatokato/partybond

# --- APK / EAS builds (required for Google login in the installed app) ---
# Copy this file to `.env` before building. Expo Go reads `.env` automatically;
# APK builds bake these values at build time via `app.config.js`.
#
# Cloud EAS build: `.env` is NOT uploaded (gitignored). Set project secrets instead
# (from Frontend/ — uses local eas-cli; no global PATH needed):
#   npm run eas:login
#   npm run eas -- secret:create --scope project --name EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID --value "YOUR_WEB_ID"
#   npm run eas -- secret:create --scope project --name EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID --value "YOUR_ANDROID_ID"
# Then rebuild: npm run build:apk:preview
#
# If `eas` is not recognized after `npm install -g eas-cli`, add npm's global bin to PATH:
#   Windows: setx PATH "%PATH%;C:\npm-global"  (then open a new terminal)
#   Or run: C:\npm-global\eas.cmd login
#
# Local EAS build (uses your .env): npm run eas -- build --platform android --profile preview --local
#
# Android OAuth client: add your APK signing SHA-1 in Google Cloud Console
# (EAS credentials: npm run eas -- credentials, or keytool -list -v -keystore ~/.android/debug.keystore)




EXPO_PUBLIC_API_URL=http://179.197.64.25:4000
# EXPO_PUBLIC_API_URL=http://localhost:4000

# Admin panel origin (optional).
# Game images are loaded from the backend: <API_URL>/game-images/<gameId>
# Set to your admin panel's IP/domain. Leave blank to show gradient placeholders instead.
# EXPO_PUBLIC_ADMIN_URL=http://179.197.64.25:3000

EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=432113151448-mk8qja7d3e69vai7vp8caaallfrbjms3.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=432113151448-bt9aodr5u7edt01oepjn5vgevmfral6g.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_EXPO_AUTH_PROXY_REDIRECT_URI=https://auth.expo.io/@hayatokato/partybond

# --- Premium / Google Play Billing ---
# IMPORTANT: matches the product IDs configured in Backend's PREMIUM_PRODUCT_IDS and in
# Google Play Console → Monetize → Products → Subscriptions. Comma-separated.
# Google Play Billing only ships in an installed APK — Expo Go can't render the purchase
# sheet. Build with `npm run build:apk:preview` to test purchases.
EXPO_PUBLIC_PREMIUM_PRODUCT_IDS=partybond.premium.monthly

# --- Invite / Referral landing page ---
# Shareable link the app uses when the user taps "Invite friends". Should be the public
# URL of the backend (e.g. https://api.partybond.com/i) — the /i/<code> route below
# redirects to the right store. Leave empty to fall back to the plain Play Store URL.
EXPO_PUBLIC_INVITE_BASE_URL=http://179.197.64.25:4000/i